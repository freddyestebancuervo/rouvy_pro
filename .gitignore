# Miscellaneous
*.class
*.log
*.pyc
*.swp
*.tmp
.DS_Store
# Basura de índice de carpetas de Windows Explorer — mismo criterio que
# .DS_Store para macOS; el equipo desarrolla también desde Windows.
Thumbs.db
ehthumbs.db
desktop.ini
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# Reportes de cobertura (p. ej. `flutter test --coverage` → coverage/lcov.info,
# el mismo artefacto que sube el job "Flutter — analyze + test" de CI) —
# generado localmente, nunca debe versionarse. El de backend/ ya estaba
# cubierto por backend/.gitignore; esto cierra el mismo hueco a nivel raíz.
coverage/

# Caché local del CLI de Firebase Hosting (`firebase deploy`/`firebase
# hosting:channel:*`) — hallazgo real de la consolidación post-Fase 4.1:
# quedaba sin ninguna regla que lo cubriera, expuesto a un `git add -A`.
.firebase/

# Caché incremental de TypeScript (`"incremental": true` en tsconfig) —
# se regenera en cada build/lint; mismo hallazgo de la consolidación
# post-Fase 4.1, sin ninguna regla previa que lo cubriera.
*.tsbuildinfo

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# VS Code related
.vscode/

# Node dependencies (cualquier subcarpeta, p. ej. firebase/seed/)
node_modules/

# Playwright MCP — artefactos de sesión (screenshots/snapshots), no código
.playwright-mcp/

# Claude Code — configuración local, no compartida
.claude/settings.local.json

# Flutter/Dart/Pub related
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
# Config local de DevTools, autogenerada al correr `flutter analyze`/`flutter
# test`/abrir DevTools — nunca contiene nada específico del proyecto.
devtools_options.yaml
flutter_*.png
linked_*.ds
unlinked.ds
unlinked_spec.ds

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local, machine-specific SDK paths — regenerado por Flutter/Android
# Studio en cada máquina, nunca debe versionarse.
android/local.properties

