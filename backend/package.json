{
  "name": "ridepro-backend",
  "version": "0.1.0",
  "description": "Backend objetivo (NestJS + PostgreSQL) — ver docs/TECHNICAL_SPECIFICATION_M0_M1.md sección 0. Scaffold de la tarea C2, sin lógica de negocio todavía.",
  "private": true,
  "scripts": {
    "build": "nest build",
