# Copiar a .env y rellenar con valores reales — .env NUNCA se commitea
# (ver .gitignore). Ninguno de estos valores debe hardcodearse en el
# código, mismo principio ya aplicado en el cliente Flutter
# (SocialLoginConfig, google-services.json como placeholders).

PORT=3000
NODE_ENV=development

# --- PostgreSQL ---
DATABASE_URL=postgres://ridepro:CHANGE_ME@localhost:5432/ridepro_dev
# Opcionales — sin definir, usan los mismos defaults de siempre (dev local):
# DATABASE_POOL_MAX=10
# DATABASE_IDLE_TIMEOUT_MS=30000
# DATABASE_CONNECTION_TIMEOUT_MS=5000
# DATABASE_SSL=true          # activar contra Postgres administrado (RDS, Cloud SQL, etc.)

# --- JWT (ver docs/TECHNICAL_SPECIFICATION_M0_M1.md sección 5.1) ---
# Par de claves RS256, no un secreto simétrico — generar con:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
JWT_ISSUER=https://api.ridepro.app
JWT_AUDIENCE=ridepro-mobile
# JWT_REFRESH_TOKEN_TTL_DAYS=30

# --- OAuth social (verificación server-side, ver spec sección 5.3) ---
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
APPLE_OAUTH_BUNDLE_ID=com.ridepro.app

# --- Infraestructura ---
# TRUST_PROXY=true   # SOLO si hay un load balancer/reverse proxy real por
                      # delante (production) — habilita leer X-Forwarded-For
                      # para rate limiting por IP correcto. Activarlo sin
                      # un proxy real permite falsificar la IP de origen.

# CORS — lista blanca de orígenes separados por coma. Sin definir, no se
# permite NINGÚN origen cross-origin (falla cerrado). Ver main.ts.
#   Dev típico (Flutter Web servido por `flutter run -d chrome`):
# CORS_ALLOWED_ORIGINS=http://localhost:PUERTO_QUE_ASIGNE_FLUTTER

# --- Seed de QA (backend/scripts/seed_qa_workouts.js) ---
# Solo para `npm run seed:qa-workouts` contra este backend LOCAL — nunca
# usar contra un entorno real. Ver lib/core/config/dev_backend_test_user.dart
# (mismas credenciales, pasadas ahí vía --dart-define-from-file).
# QA_BACKEND_EMAIL=qa.workouts@ridepro.local
# QA_BACKEND_PASSWORD=elegir-una-contraseña-solo-local
# QA_BACKEND_DISPLAY_NAME=QA Workouts
