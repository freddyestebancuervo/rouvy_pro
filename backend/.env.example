# Copiar a .env y rellenar con valores reales — .env NUNCA se commitea
# (ver .gitignore). Ninguno de estos valores debe hardcodearse en el
# código, mismo principio ya aplicado en el cliente Flutter
# (SocialLoginConfig, google-services.json como placeholders).

PORT=3000
NODE_ENV=development

# --- PostgreSQL ---
DATABASE_URL=postgres://ridepro:CHANGE_ME@localhost:5432/ridepro_dev
# Opcionales — sin definir, usan los mismos defaults de siempre (dev local):
# DATABASE_POOL_MAX=10
# DATABASE_IDLE_TIMEOUT_MS=30000
# DATABASE_CONNECTION_TIMEOUT_MS=5000
# DATABASE_SSL=true          # activar contra Postgres administrado (RDS, Cloud SQL, etc.)

# --- Redis (T-F0.4: storage distribuido del rate limiter, reemplaza el
# storage en memoria — ver app.module.ts) ---
# Requerida salvo BACKEND_ENVIRONMENT=development (ver mas abajo), en
# cuyo caso su ausencia hace fallback a throttling en memoria en vez de
# fallar el arranque (ver config/redis.config.ts, resolveThrottlerStrategy).
REDIS_URL=redis://CHANGE_ME:6379

# --- BACKEND_ENVIRONMENT (T-F0.2 Puerta F) ---
# Variable propia del throttler, deliberadamente distinta de NODE_ENV (la
# imagen Docker final fija NODE_ENV=production incluso al desplegarse en
# el entorno GCP Development) y de FIREBASE_PROJECT_ID (no acoplar el
# throttler a Firebase). Valores soportados: development, staging,
# production.
#   development: permite fallback a memoria si REDIS_URL falta. Esta
#                destinado a Development de baja concurrencia y requiere
#                service-level max=1 en Cloud Run como guard operativo.
#                No ofrece consistencia distribuida fuerte y no sustituye
#                Redis cuando el backend necesite escalado horizontal.
#   staging / production / ausente / desconocido: REDIS_URL es obligatoria;
#                sin ella el arranque falla cerrado, nunca se degrada en
#                silencio a memoria.
BACKEND_ENVIRONMENT=development

# --- JWT (ver docs/TECHNICAL_SPECIFICATION_M0_M1.md sección 5.1) ---
# Par de claves RS256, no un secreto simétrico — generar con:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
JWT_ISSUER=https://api.ridepro.app
JWT_AUDIENCE=ridepro-mobile
# JWT_REFRESH_TOKEN_TTL_DAYS=30

# --- OAuth social (verificación server-side, ver spec sección 5.3) ---
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
APPLE_OAUTH_BUNDLE_ID=com.ridepro.app

# --- Firebase Admin SDK (puente Firebase Auth → NestJS, Fase 3) ---
# Obligatoria — el arranque falla si falta (ver FirebaseAdminModule).
# Debe coincidir exactamente con el proyecto Firebase de este entorno
# (ridepro-development en Development) — nunca el de Producción.
FIREBASE_PROJECT_ID=ridepro-development
# Credenciales: SIEMPRE Application Default Credentials (nunca un JSON de
# cuenta de servicio) — en Cloud Run resuelve solas contra la identidad de
# la revisión, sin ninguna variable adicional acá.
#
# `checkRevoked` (verificar que la sesión de Firebase no fue cerrada/
# deshabilitada) requiere que la cuenta de servicio en uso tenga el rol
# IAM roles/firebaseauth.viewer (permiso firebaseauth.users.get) — otorgado
# en Development a ridepro-backend-dev-sa (ver cierre técnico post-Fase 4).
# En un entorno nuevo sin ese rol, dejar en "false": activarlo antes de
# tiempo haría fallar TODOS los exchanges, no solo la revocación.
FIREBASE_CHECK_REVOKED=true

# --- Infraestructura ---
# TRUST_PROXY=true   # SOLO si hay un load balancer/reverse proxy real por
                      # delante (production) — habilita leer X-Forwarded-For
                      # para rate limiting por IP correcto. Activarlo sin
                      # un proxy real permite falsificar la IP de origen.

# CORS — lista blanca de orígenes separados por coma. Sin definir, no se
# permite NINGÚN origen cross-origin (falla cerrado). Ver main.ts.
#   Dev típico (Flutter Web servido por `flutter run -d chrome`):
# CORS_ALLOWED_ORIGINS=http://localhost:PUERTO_QUE_ASIGNE_FLUTTER

# --- Seed de QA (backend/scripts/seed_qa_workouts.js) ---
# Solo para `npm run seed:qa-workouts` contra este backend LOCAL — nunca
# usar contra un entorno real. Ver lib/core/config/dev_backend_test_user.dart
# (mismas credenciales, pasadas ahí vía --dart-define-from-file).
# QA_BACKEND_EMAIL=qa-backend@example.invalid
# QA_BACKEND_PASSWORD=elegir-una-contraseña-solo-local
# QA_BACKEND_DISPLAY_NAME=QA Workouts
